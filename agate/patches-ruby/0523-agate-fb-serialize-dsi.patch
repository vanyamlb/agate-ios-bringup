+bool
+AppleCLCD::panelReady(void)
+{
+	if (fDsi == NULL || fMutex == NULL) {
+		return true;
+	}
+	if (fMbox != NULL) {
+		/* Pause the shim kicker before either framebuffer writer starts. */
+		fMbox[0] = AGATE_MBOX_MAGIC;
+		fMbox[1] = ++fKickSeq;
+		__asm__ __volatile__("dsb sy" ::: "memory");
+	}
+	/* DSI_INTSTA bit 31 indicates an in-flight transfer. */
+	for (int i = 0; i < 400; i++) {
+		if ((fDsi[0x0c / 4] & 0x80000000u) == 0) {
+			return true;
+		}
 		IODelay(100);
 	}
+	if (!fPanelBusyReported) {
+		fPanelBusyReported = true;
+		IOLog("SWEET FB: skipping panel write while DSI is busy\n");
+	}
+	return false;
+}
+
+void
+AppleCLCD::fadePanel(void)
+{
+	IOLockLock(fPresentLock);
+	IOLockLock(fLock);
+	const bool fade = fPowerOff && fFadeStep <= 6;
+	const uint32_t step = fFadeStep;
+	IOLockUnlock(fLock);
+	if (fade && panelReady()) {
+		for (uint32_t y = 0; y < fHeight; y++) {
+			volatile uint32_t *row = (volatile uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+			for (uint32_t x = 0; x < fWidth; x++) {
+				row[x] = step < 6 ? (row[x] >> 1) & 0x7f7f7f7f : 0;
+			}
+		}
+		flush_dcache64((addr64_t)fPixels, (uint32_t)((uint64_t)fHeight * fRowBytes), FALSE);
+		panelKick();
+		IOLockLock(fLock);
+		fFadeStep++;
+		IOLockUnlock(fLock);
+	}
+	IOLockUnlock(fPresentLock);
 }
 
