+/* ---- A5: the rings for the station (bsd/dev/agate_wlan/agate_mtkwifi.c) ---- */
+typedef void (*agate_wf_event_fn)(uint8_t eid, uint8_t seq, const uint8_t *body, uint32_t length);
+typedef void (*agate_wf_frame_fn)(const uint8_t *rx, uint32_t length);
+static uint8_t ac_rxcopy[RXB_SIZE];
+
+static void
+ac_copyout(vm_offset_t src, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i += 4) {
+		uint32_t w = readl(src + i);
+		ac_rxcopy[i] = w & 0xff;
+		ac_rxcopy[i + 1] = (w >> 8) & 0xff;
+		ac_rxcopy[i + 2] = (w >> 16) & 0xff;
+		ac_rxcopy[i + 3] = (w >> 24) & 0xff;
+	}
+}
+
+void
+agate_wf_dump(const char *why)
+{
+	if (!pool) {
+		return;
+	}
+	ac_wfdma_dump(why);
+	pr_info("WFDMA0 %s: G0=%08x R0 b=%08x n=%u c=%u d=%u ext=%08x; R0 desc[0] %08x %08x, ours at %u\n", why,
+	    readl(wd0 + 0x208), readl(wd0 + 0x500), readl(wd0 + 0x504), readl(wd0 + 0x508), readl(wd0 + 0x50c),
+	    readl(wd0 + 0x680), readl(pool + RX0R_OFF), readl(pool + RX0R_OFF + 4), ac_rx0idx);
+}
+
+uint8_t
+agate_wf_cmd(uint8_t cid, int set, const void *payload, uint32_t plen)
+{
+	return pool ? ac_cmd(cid, set, payload, plen) : 0;
+}
+
+void
+agate_wf_pump(agate_wf_event_fn event, agate_wf_frame_fn frame)
+{
+	if (!pool) {
+		return;
+	}
+	for (int n = 0; n < RING_N; n++) {          /* WFDMA1 RX 0: events (and frames of the SW type 0x3801) */
+		vm_offset_t rd = pool + RXR_OFF + ac_rxidx * 16;
+		uint32_t d1 = readl(rd + 4);
+		if (!(d1 & (1u << 31))) {
+			break;
+		}
+		uint32_t rlen = (d1 >> 16) & 0x3fff;
+		if (rlen > RXB_SIZE) {
+			rlen = RXB_SIZE;
+		}
+		ac_copyout(pool + RXB_OFF + ac_rxidx * RXB_SIZE, (rlen + 3) & ~3u);
+		writel((uint32_t)RXB_SIZE << 16, rd + 4);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		writel(ac_rxidx, wd1 + 0x508);
+		ac_rxidx = (ac_rxidx + 1) % RING_N;
+		uint32_t d0 = ac_rxcopy[0] | ac_rxcopy[1] << 8 | ac_rxcopy[2] << 16 | (uint32_t)ac_rxcopy[3] << 24;
+		if (((d0 >> 16) & 0x380f) == 0x3801 || ((d0 >> 27) & 0x1f) == 2) {
+			frame(ac_rxcopy, rlen);
+		} else if (rlen >= 36) {
+			if (ac_rxcopy[28] == 0x0d) {
+				ac_scan_done = 1;
+			}
+			event(ac_rxcopy[28], ac_rxcopy[29], ac_rxcopy + 36, rlen - 36);
+		}
+	}
+	for (int n = 0; n < RX0_N; n++) {           /* WFDMA0 RX 0: frames */
+		vm_offset_t rd = pool + RX0R_OFF + ac_rx0idx * 16;
+		uint32_t d1 = readl(rd + 4);
+		if (!(d1 & (1u << 31))) {
+			break;
+		}
+		uint32_t rlen = (d1 >> 16) & 0x3fff;
+		if (rlen > RXB_SIZE) {
+			rlen = RXB_SIZE;
+		}
+		ac_copyout(pool + RX0B_OFF + ac_rx0idx * RXB_SIZE, (rlen + 3) & ~3u);
+		writel((uint32_t)RXB_SIZE << 16, rd + 4);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		writel(ac_rx0idx, wd0 + 0x508);
+		ac_rx0idx = (ac_rx0idx + 1) % RX0_N;
+		frame(ac_rxcopy, rlen);
+	}
+}
