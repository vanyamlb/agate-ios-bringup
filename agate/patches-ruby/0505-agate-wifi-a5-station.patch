 static uint8_t ac_mac[6];
 
+/* wait for room on TX ring 17 (the DMA's index two behind ours at least) */
+static int
+ac_tx_room(void)
+{
+	for (int i = 0; i < 2000; i++) {
+		if ((ac_txidx + 1) % RING_N != readl(wd1 + 0x41c)) {
+			return 0;
+		}
+		delay(50);
+	}
+	return -1;
+}
+
+/* a packet already holding its TXD (frames for the MCU to send) onto TX ring 17 */
+int
+agate_wf_tx(const uint8_t *pkt, uint32_t len)
+{
+	vm_offset_t buf, td;
+	uint32_t i, w;
+
+	if (!pool || len > TXB_SIZE || ac_tx_room()) {
+		return -1;
+	}
+	buf = pool + TXB_OFF + ac_txidx * TXB_SIZE;
+	td = pool + TXR_OFF + ac_txidx * 16;
+	for (i = 0; i < len; i += 4) {
+		w = 0;
+		for (uint32_t k = 0; k < 4 && i + k < len; k++) {
+			w |= (uint32_t)pkt[i + k] << (8 * k);
+		}
+		writel(w, buf + i);
+	}
+	writel((uint32_t)(DMA_POOL_PA + TXB_OFF + ac_txidx * TXB_SIZE), td + 0);
+	writel(0, td + 8);
+	writel(0, td + 12);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	writel((len << 16) | (1u << 30), td + 4);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ac_txidx = (ac_txidx + 1) % RING_N;
+	writel(ac_txidx, wd1 + 0x418);
+	return 0;
+}
+
