diff --git a/iokit/Kernel/arm/AgateWLAN.cpp b/iokit/Kernel/arm/AgateWLAN.cpp
new file mode 100644
index 0000000..aa4a3a6
--- /dev/null
+++ b/iokit/Kernel/arm/AgateWLAN.cpp
@@ -0,0 +1,330 @@
+/*
+ * agate (Xiaomi 11T): the MT6893's Wi-Fi as iOS expects to find a Wi-Fi adapter.
+ *
+ * As HakiOS found (its iokit/Kernel/RedwoodWLAN.cpp, APSL 2.0): wifid's device is the service
+ * whose property IO80211InterfaceRole is "Infrastructure" and whose IOInterfaceName is the
+ * interface; with no user client to open, IO80211.framework falls back to ioctls
+ * (SIOCGA80211/SIOCSA80211), answered by bsd/dev/agate_wlan/redwood_apple80211.c; and
+ * SystemConfiguration calls an IONetworkInterface a Wi-Fi interface when its controller is an
+ * IO80211Controller. agate has IONetworkingFamily built in (0497), so here that is a real
+ * IOEthernetController (as AgateECMEthernet): the class IO80211Controller in between, its
+ * interface an IOEthernetInterface of the Wi-Fi subfamily that hands the Apple80211 ioctls on.
+ * Named en0 (USB networking moves to en1 when agatewifi >= 8).
+ *
+ * Frames: outputPacket -> agate_mtkwifi_transmit() (bsd/dev/agate_wlan/agate_mtkwifi.c);
+ * redwood_net_input() / redwood_net_link_state() back the other way.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/network/IOEthernetController.h>
+#include <IOKit/network/IOEthernetInterface.h>
+#include <IOKit/network/IONetworkMedium.h>
+#include <IOKit/network/IOOutputQueue.h>
+#include <sys/kpi_mbuf.h>
+#include <net/kpi_interface.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+#define SIOCSA80211     0x802869c8u
+#define SIOCGA80211     0xc02869c9u
+
+extern "C" {
+int  agate_mtkwifi_transmit(const uint8_t *frame, uint32_t length);
+errno_t redwood_apple80211_ioctl(u_long command, void *data);
+kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+void thread_deallocate(thread_t);
+}
+
+class IO80211Controller : public IOEthernetController {
+	OSDeclareAbstractStructors(IO80211Controller);
+};
+OSDefineMetaClassAndAbstractStructors(IO80211Controller, IOEthernetController);
+
+class AgateWLANInterface : public IOEthernetInterface {
+	OSDeclareDefaultStructors(AgateWLANInterface);
+public:
+	bool init(IONetworkController *controller) APPLE_KEXT_OVERRIDE;
+	SInt32 performCommand(IONetworkController *ctr, unsigned long cmd, void *arg0, void *arg1) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AgateWLANInterface, IOEthernetInterface);
+
+bool
+AgateWLANInterface::init(IONetworkController *controller)
+{
+	if (!IOEthernetInterface::init(controller)) {
+		return false;
+	}
+	setInterfaceSubType(IFNET_SUBFAMILY_WIFI);
+	setProperty("IO80211InterfaceRole", "Infrastructure");
+	setProperty("IOBuiltin", true);
+	return true;
+}
+
+SInt32
+AgateWLANInterface::performCommand(IONetworkController *ctr, unsigned long cmd, void *arg0, void *arg1)
+{
+	if (cmd == SIOCSA80211 || cmd == SIOCGA80211) {
+		return redwood_apple80211_ioctl(cmd, arg1);
+	}
+	return IOEthernetInterface::performCommand(ctr, cmd, arg0, arg1);
+}
+
+class AgateWLAN : public IO80211Controller {
+	OSDeclareDefaultStructors(AgateWLAN);
+public:
+	IOEthernetInterface *fNetif;
+	IONetworkMedium     *fMedium;
+	IOWorkLoop          *fWorkLoop;
+	volatile bool        fEnabled, fLinked;
+	uint8_t              fMac[6];
+
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	bool createWorkLoop(void) APPLE_KEXT_OVERRIDE;
+	IOWorkLoop *getWorkLoop(void) const APPLE_KEXT_OVERRIDE;
+	IONetworkInterface *createInterface(void) APPLE_KEXT_OVERRIDE;
+	IOReturn enable(IONetworkInterface *netif) APPLE_KEXT_OVERRIDE;
+	IOReturn disable(IONetworkInterface *netif) APPLE_KEXT_OVERRIDE;
+	UInt32 outputPacket(mbuf_t m, void *param) APPLE_KEXT_OVERRIDE;
+	IOReturn getHardwareAddress(IOEthernetAddress *addr) APPLE_KEXT_OVERRIDE;
+	IOReturn setPromiscuousMode(bool active) APPLE_KEXT_OVERRIDE;
+	IOReturn setMulticastMode(bool active) APPLE_KEXT_OVERRIDE;
+	IOReturn setMulticastList(IOEthernetAddress *addrs, UInt32 count) APPLE_KEXT_OVERRIDE;
+	void input(const uint8_t *data, uint32_t len);
+	void link(bool up);
+	static void nameThread(void *arg, wait_result_t wr);
+};
+OSDefineMetaClassAndStructors(AgateWLAN, IO80211Controller);
+
+static AgateWLAN *gAgateWLAN;
+
+bool
+AgateWLAN::createWorkLoop(void)
+{
+	fWorkLoop = IOWorkLoop::workLoop();
+	return fWorkLoop != NULL;
+}
+
+IOWorkLoop *
+AgateWLAN::getWorkLoop(void) const
+{
+	return fWorkLoop;
+}
+
+IONetworkInterface *
+AgateWLAN::createInterface(void)
+{
+	AgateWLANInterface *netif = new AgateWLANInterface;
+
+	if (netif != NULL && !netif->init(this)) {
+		netif->release();
+		netif = NULL;
+	}
+	return netif;
+}
+
+bool
+AgateWLAN::start(IOService *provider)
+{
+	if (!IO80211Controller::start(provider)) {
+		IOLog("AGATE WLAN: IOEthernetController::start failed\n");
+		return false;
+	}
+	OSDictionary *media = OSDictionary::withCapacity(1);
+	fMedium = IONetworkMedium::medium(kIOMediumIEEE80211Auto, 54000000);
+	if (media == NULL || fMedium == NULL ||
+	    !IONetworkMedium::addMedium(media, fMedium) ||
+	    !publishMediumDictionary(media)) {
+		IOLog("AGATE WLAN: medium setup failed\n");
+		OSSafeReleaseNULL(media);
+		return false;
+	}
+	media->release();
+	setProperty("IOModel", "MT6893 CONNAC2 Wi-Fi");
+	setProperty("IOVendor", "MediaTek");
+	setProperty("IOBuiltin", true);
+	if (!attachInterface((IONetworkInterface **)&fNetif, false)) {
+		IOLog("AGATE WLAN: attachInterface failed\n");
+		return false;
+	}
+	fNetif->registerService();
+
+	thread_t th;
+	retain();
+	if (kernel_thread_start((thread_continue_t)&AgateWLAN::nameThread, this, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		release();
+	}
+	IOLog("AGATE WLAN: controller up (%02x:%02x:%02x:%02x:%02x:%02x)\n",
+	    fMac[0], fMac[1], fMac[2], fMac[3], fMac[4], fMac[5]);
+	return true;
+}
+
+/* as AgateECMEthernet: ask IONetworkStack for en0 ourselves (configd's namer waits forever here) */
+void
+AgateWLAN::nameThread(void *arg, wait_result_t wr __unused)
+{
+	AgateWLAN *self = (AgateWLAN *)arg;
+	OSDictionary *match = IOService::serviceMatching("IONetworkStack");
+	IOService *stack = match ? IOService::waitForMatchingService(match, 30ULL * NSEC_PER_SEC) : NULL;
+
+	OSSafeReleaseNULL(match);
+	if (stack != NULL && self->fNetif != NULL) {
+		uint64_t id = self->fNetif->getRegistryEntryID();
+		OSDictionary *cmd = OSDictionary::withCapacity(3);
+		OSNumber *type = OSNumber::withNumber(1ULL, 32);
+		OSNumber *unit = OSNumber::withNumber(0ULL, 32);
+		OSData *eid = OSData::withBytes(&id, sizeof(id));
+		IOReturn ret = kIOReturnNoMemory;
+		if (cmd && type && unit && eid) {
+			cmd->setObject("IONetworkStackUserCommand", type);
+			cmd->setObject("IOInterfaceUnit", unit);
+			cmd->setObject("IORegistryEntryID", eid);
+			ret = stack->setProperties(cmd);
+		}
+		IOLog("AGATE WLAN: asked IONetworkStack for a name: 0x%x, now %s%u\n",
+		    ret, self->fNetif->getNamePrefix(), self->fNetif->getUnitNumber());
+		OSSafeReleaseNULL(cmd);
+		OSSafeReleaseNULL(type);
+		OSSafeReleaseNULL(unit);
+		OSSafeReleaseNULL(eid);
+		stack->release();
+	} else {
+		IOLog("AGATE WLAN: no IONetworkStack, naming left to configd\n");
+	}
+	self->release();
+}
+
+IOReturn
+AgateWLAN::enable(IONetworkInterface *netif __unused)
+{
+	fEnabled = true;
+	setLinkStatus(kIONetworkLinkValid | (fLinked ? kIONetworkLinkActive : 0),
+	    fLinked ? fMedium : NULL, fLinked ? 54000000 : 0);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AgateWLAN::disable(IONetworkInterface *netif __unused)
+{
+	fEnabled = false;
+	setLinkStatus(kIONetworkLinkValid, NULL, 0);
+	return kIOReturnSuccess;
+}
+
+void
+AgateWLAN::link(bool up)
+{
+	fLinked = up;
+	if (fEnabled) {
+		setLinkStatus(kIONetworkLinkValid | (up ? kIONetworkLinkActive : 0),
+		    up ? fMedium : NULL, up ? 54000000 : 0);
+	}
+	IOLog("AGATE WLAN: link %s\n", up ? "UP" : "down");
+}
+
+UInt32
+AgateWLAN::outputPacket(mbuf_t m, void *param __unused)
+{
+	uint8_t frame[1600];
+	size_t len = mbuf_pkthdr_len(m);
+
+	if (fEnabled && fLinked && len >= 14 && len <= 1514 &&
+	    mbuf_copydata(m, 0, len, frame) == 0) {
+		(void)agate_mtkwifi_transmit(frame, (uint32_t)len);
+	}
+	freePacket(m);
+	return kIOReturnOutputSuccess;
+}
+
+IOReturn
+AgateWLAN::getHardwareAddress(IOEthernetAddress *addr)
+{
+	bcopy(fMac, addr->bytes, 6);
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AgateWLAN::setPromiscuousMode(bool active __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AgateWLAN::setMulticastMode(bool active __unused)
+{
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AgateWLAN::setMulticastList(IOEthernetAddress *addrs __unused, UInt32 count __unused)
+{
+	return kIOReturnSuccess;
+}
+
+void
+AgateWLAN::input(const uint8_t *data, uint32_t len)
+{
+	if (!fEnabled || fNetif == NULL) {
+		return;
+	}
+	mbuf_t m = allocatePacket(len);
+	if (m == NULL) {
+		return;
+	}
+	if (mbuf_copyback(m, 0, len, data, MBUF_DONTWAIT) != 0) {
+		freePacket(m);
+		return;
+	}
+	fNetif->inputPacket(m, len, 0);
+}
+
+extern "C" int
+agate_wlan_create(const uint8_t *mac)
+{
+	AgateWLAN *w = new AgateWLAN;
+	IOService *prov = IOService::getResourceService();
+
+	if (w == NULL || !w->init(NULL)) {
+		OSSafeReleaseNULL(w);
+		return -1;
+	}
+	bcopy(mac, w->fMac, 6);
+	OSData *d = OSData::withBytes(mac, 6);
+	if (d != NULL) {
+		w->setProperty("IOMACAddress", d);
+		d->release();
+	}
+	if (!w->attach(prov)) {
+		w->release();
+		return -1;
+	}
+	if (!w->start(prov)) {
+		w->detach(prov);
+		w->release();
+		return -1;
+	}
+	w->registerService();
+	gAgateWLAN = w;
+	return 0;
+}
+
+extern "C" void
+redwood_net_input(const uint8_t *frame, size_t length)
+{
+	if (gAgateWLAN != NULL) {
+		gAgateWLAN->input(frame, (uint32_t)length);
+	}
+}
+
+extern "C" void
+redwood_net_link_state(bool up)
+{
+	if (gAgateWLAN != NULL) {
+		gAgateWLAN->link(up);
+	}
+}
+#endif /* SWEET */
