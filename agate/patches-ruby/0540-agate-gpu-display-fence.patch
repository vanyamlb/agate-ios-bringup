 /* K0c: the display (AppleCLCD) and IOSurfaceLock wait for the GPU's writes to a surface. */
+IOReturn
+viva_gpu_copy_display_frame(SweetSurface *const *surfaces, uint32_t count, void (^copy)(void))
+{
+	VivaGPUAccelerator *gpu = gVivaGPU;
+	if (gpu == NULL || gpu->gate() == NULL) {
+		copy();
+		return kIOReturnSuccess;
+	}
+	return gpu->gate()->runActionBlock(^IOReturn {
+		for (uint32_t i = 0; i < count; i++) {
+			SweetSurface *s = surfaces[i];
+			if (s == NULL) {
+				continue;
+			}
+			VivaGPUFence *f = OSDynamicCast(VivaGPUFence, s->gpuFence);
+			if (f != NULL && !f->signalled) {
+				return kIOReturnBusy;
+			}
+			if (f != NULL && f->error != kIOReturnSuccess) {
+				return kIOReturnIOError;
+			}
+		}
+		/* Keep GPU submission gated while the CPU snapshots the frame. */
+		copy();
+		return kIOReturnSuccess;
+	});
+}
