diff --git a/bsd/kern/decmpfs.c b/bsd/kern/decmpfs.c
index ff8c5e3..297595a 100644
--- a/bsd/kern/decmpfs.c
+++ b/bsd/kern/decmpfs.c
@@ -2347,6 +2347,359 @@ SECURITY_READ_ONLY_EARLY(static decmpfs_registration) Type1Reg =
 	.get_flags         = NULL/* no flags */
 };
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#pragma mark --- zlib compressors (Type3/Type4, agate) ---
+
+/*
+ * agate: the open-source kernel has no AppleFSCompression.kext, so files that
+ * macOS `ditto --hfsCompression` stored with the zlib decmpfs types could not
+ * be read ("compressed file of unregistered type 4"). These two decompressors
+ * use libkern's zlib:
+ *
+ *   Type 3: the whole file in the com.apple.decmpfs xattr, after the 16-byte
+ *           header.
+ *   Type 4: the file in the resource fork, as 64 KiB chunks:
+ *             +0          resource fork header, u32 BE data offset D
+ *             +D          u32 BE resource length
+ *             +D+4        u32 LE chunk count n, then n x { u32 LE offset,
+ *                         u32 LE size }, offsets relative to D+4
+ *
+ * A unit (type 3 payload or type 4 chunk) whose first byte has the low nibble
+ * 0xF is stored raw after that byte; anything else is a zlib stream.
+ * Type 9 keeps small files raw in the xattr after a 0xCC byte. Other Apple
+ * types (LZVN, LZFSE, LZBITMAP) are rewritten as type 4 when the root image is
+ * built (agate/tools/hfs_zlib.py), which also checks every file against this
+ * decoder.
+ */
+#include <libkern/zlib.h>
+
+#define AGATE_CHUNK     0x10000u
+#define AGATE_MAX_TYPE3 (16u << 20)
+
+typedef struct {
+	uint32_t size;
+	uint32_t pad;
+	uint8_t  data[0];
+} agate_zmem;
+
+static void *
+agate_zalloc(void *opaque __unused, u_int items, u_int size)
+{
+	uint64_t total = (uint64_t)items * size + sizeof(agate_zmem);
+	if (total > UINT32_MAX) {
+		return NULL;
+	}
+	agate_zmem *m = kalloc_data((vm_size_t)total, Z_WAITOK);
+	if (m == NULL) {
+		return NULL;
+	}
+	m->size = (uint32_t)total;
+	return m->data;
+}
+
+static void
+agate_zfree(void *opaque __unused, void *ptr)
+{
+	agate_zmem *m = (agate_zmem *)((uint8_t *)ptr - offsetof(agate_zmem, data));
+	kfree_data(m, m->size);
+}
+
+/* Decode one stored unit into out[0, outlen); *produced gets the byte count. */
+static int
+agate_unpack(const uint8_t *in, size_t inlen, uint8_t *out, size_t outlen, size_t *produced)
+{
+	*produced = 0;
+	if (inlen == 0) {
+		return EIO;
+	}
+	if ((in[0] & 0x0f) == 0x0f) {
+		size_t n = MIN(inlen - 1, outlen);
+		memcpy(out, in + 1, n);
+		*produced = n;
+		return 0;
+	}
+	z_stream zs;
+	bzero(&zs, sizeof(zs));
+	zs.zalloc = agate_zalloc;
+	zs.zfree = agate_zfree;
+	zs.next_in = (Bytef *)(uintptr_t)in;
+	zs.avail_in = (uInt)inlen;
+	zs.next_out = out;
+	zs.avail_out = (uInt)outlen;
+	if (inflateInit(&zs) != Z_OK) {
+		return ENOMEM;
+	}
+	int zr = inflate(&zs, Z_FINISH);
+	*produced = outlen - zs.avail_out;
+	inflateEnd(&zs);
+	if (zr != Z_STREAM_END && zs.avail_out != 0) {
+		return EIO;
+	}
+	return 0;
+}
+
+/* Sequential writer over the caller's vectors (they cover offset..offset+size). */
+struct agate_cursor {
+	int nvec;
+	decmpfs_vector *vec;
+	int i;
+	user_ssize_t off;
+	uint64_t total;
+};
+
+static void
+agate_put(struct agate_cursor *c, const uint8_t *src, size_t len)
+{
+	while (len > 0 && c->i < c->nvec) {
+		user_ssize_t room = c->vec[c->i].size - c->off;
+		if (room <= 0) {
+			c->i++;
+			c->off = 0;
+			continue;
+		}
+		size_t n = MIN(len, (size_t)room);
+		memcpy((uint8_t *)c->vec[c->i].buf + c->off, src, n);
+		c->off += n;
+		src += n;
+		len -= n;
+		c->total += n;
+	}
+}
+
+static int
+agate_validate_Type3(__unused vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr)
+{
+	if (hdr->attr_size <= sizeof(decmpfs_disk_header) || hdr->uncompressed_size > AGATE_MAX_TYPE3) {
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+agate_fetch_Type3(__unused vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr, off_t offset,
+    user_ssize_t size, int nvec, decmpfs_vector *vec, uint64_t *bytes_read)
+{
+	uint64_t usize = hdr->uncompressed_size;
+	struct agate_cursor c = { .nvec = nvec, .vec = vec };
+	size_t produced = 0;
+	int err;
+
+	*bytes_read = 0;
+	if (agate_validate_Type3(vp, ctx, hdr) != 0 || offset < 0 || (uint64_t)offset > usize) {
+		return EINVAL;
+	}
+	vm_size_t alloc = usize ? (vm_size_t)usize : 1;
+	uint8_t *buf = kalloc_data(alloc, Z_WAITOK);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	err = agate_unpack(hdr->attr_bytes, hdr->attr_size - sizeof(decmpfs_disk_header), buf, (size_t)usize, &produced);
+	if (err == 0 && produced != usize) {
+		err = EIO;
+	}
+	if (err == 0) {
+		agate_put(&c, buf + offset, (size_t)MIN((uint64_t)size, usize - (uint64_t)offset));
+		*bytes_read = c.total;
+	}
+	kfree_data(buf, alloc);
+	return err;
+}
+
+/* Read len bytes of vp's resource fork at off into buf. */
+static int
+agate_rsrc_read(vnode_t vp, vfs_context_t ctx, uint64_t off, void *buf, size_t len)
+{
+	UIO_STACKBUF(uio_buf, 1);
+	uio_t uio = uio_createwithbuffer(1, (off_t)off, UIO_SYSSPACE, UIO_READ, &uio_buf[0], sizeof(uio_buf));
+	size_t got = len;
+	uio_addiov(uio, CAST_USER_ADDR_T(buf), len);
+	int err = vn_getxattr(vp, XATTR_RESOURCEFORK_NAME, uio, &got, XATTR_NOSECURITY, ctx);
+	if (err == 0 && uio_resid(uio) != 0) {
+		err = EIO;
+	}
+	return err;
+}
+
+static int
+agate_validate_Type4(__unused vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr)
+{
+	return hdr->attr_size >= sizeof(decmpfs_disk_header) ? 0 : EINVAL;
+}
+
+static void
+agate_adjust_Type4(__unused vnode_t vp, __unused vfs_context_t ctx, __unused decmpfs_header *hdr,
+    off_t *offset, user_ssize_t *size)
+{
+	/* whole chunks: each one is decompressed once per fetch anyway */
+	off_t start = *offset & ~(off_t)(AGATE_CHUNK - 1);
+	off_t end = (*offset + *size + AGATE_CHUNK - 1) & ~(off_t)(AGATE_CHUNK - 1);
+	*offset = start;
+	*size = (user_ssize_t)(end - start);
+}
+
+static int
+agate_fetch_Type4(vnode_t vp, vfs_context_t ctx, decmpfs_header *hdr, off_t offset,
+    user_ssize_t size, int nvec, decmpfs_vector *vec, uint64_t *bytes_read)
+{
+	uint64_t usize = hdr->uncompressed_size;
+	struct agate_cursor c = { .nvec = nvec, .vec = vec };
+	uint8_t be[4], le[4];
+	uint32_t *tbl = NULL;
+	uint8_t *chunk = NULL, *comp = NULL;
+	size_t tbl_size = 0, comp_alloc = 0;
+	int err;
+
+	*bytes_read = 0;
+	if (offset < 0 || size <= 0 || (uint64_t)offset >= usize) {
+		return 0;
+	}
+	size = (user_ssize_t)MIN((uint64_t)size, usize - (uint64_t)offset);
+	uint64_t first = (uint64_t)offset / AGATE_CHUNK;
+	uint64_t last = ((uint64_t)offset + (uint64_t)size - 1) / AGATE_CHUNK;
+	uint64_t needed = (usize + AGATE_CHUNK - 1) / AGATE_CHUNK;
+
+	err = agate_rsrc_read(vp, ctx, 0, be, 4);
+	if (err) {
+		goto out;
+	}
+	uint64_t base = (uint64_t)OSReadBigInt32(be, 0) + 4;
+	err = agate_rsrc_read(vp, ctx, base, le, 4);
+	if (err) {
+		goto out;
+	}
+	uint32_t n = OSReadLittleInt32(le, 0);
+	if (n < needed || last >= n) {
+		err = EIO;
+		goto out;
+	}
+	tbl_size = (size_t)(last - first + 1) * 8;
+	tbl = kalloc_data(tbl_size, Z_WAITOK);
+	chunk = kalloc_data(AGATE_CHUNK, Z_WAITOK);
+	if (tbl == NULL || chunk == NULL) {
+		err = ENOMEM;
+		goto out;
+	}
+	err = agate_rsrc_read(vp, ctx, base + 4 + first * 8, tbl, tbl_size);
+	if (err) {
+		goto out;
+	}
+	for (uint64_t k = first; k <= last; k++) {
+		uint32_t coff = OSReadLittleInt32(tbl, (k - first) * 8);
+		uint32_t csize = OSReadLittleInt32(tbl, (k - first) * 8 + 4);
+		uint64_t cstart = k * AGATE_CHUNK;
+		size_t want = (size_t)MIN((uint64_t)AGATE_CHUNK, usize - cstart);
+		size_t produced = 0;
+
+		if (csize == 0 || csize > 2 * AGATE_CHUNK) {
+			err = EIO;
+			break;
+		}
+		if (csize > comp_alloc) {
+			if (comp) {
+				kfree_data(comp, comp_alloc);
+			}
+			comp_alloc = csize;
+			comp = kalloc_data(comp_alloc, Z_WAITOK);
+			if (comp == NULL) {
+				comp_alloc = 0;
+				err = ENOMEM;
+				break;
+			}
+		}
+		err = agate_rsrc_read(vp, ctx, base + coff, comp, csize);
+		if (err) {
+			break;
+		}
+		err = agate_unpack(comp, csize, chunk, want, &produced);
+		if (err == 0 && produced != want) {
+			err = EIO;
+		}
+		if (err) {
+			break;
+		}
+		uint64_t from = MAX((uint64_t)offset, cstart);
+		uint64_t to = MIN((uint64_t)offset + (uint64_t)size, cstart + want);
+		if (to > from) {
+			agate_put(&c, chunk + (from - cstart), (size_t)(to - from));
+		}
+	}
+	if (err == 0) {
+		*bytes_read = c.total;
+	}
+out:
+	if (comp) {
+		kfree_data(comp, comp_alloc);
+	}
+	if (chunk) {
+		kfree_data(chunk, AGATE_CHUNK);
+	}
+	if (tbl) {
+		kfree_data(tbl, tbl_size);
+	}
+	if (err) {
+		ErrorLogWithPath("agate zlib type %u: error %d at offset %lld\n", hdr->compression_type, err, (long long)offset);
+	}
+	return err;
+}
+
+/* Type 9: small files stored raw in the xattr after a 0xCC byte (ditto keeps these). */
+static int
+agate_validate_Type9(__unused vnode_t vp, __unused vfs_context_t ctx, decmpfs_header *hdr)
+{
+	if ((uint64_t)hdr->attr_size != sizeof(decmpfs_disk_header) + 1 + hdr->uncompressed_size ||
+	    hdr->attr_bytes[0] != 0xcc) {
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+agate_fetch_Type9(vnode_t vp, vfs_context_t ctx, decmpfs_header *hdr, off_t offset,
+    user_ssize_t size, int nvec, decmpfs_vector *vec, uint64_t *bytes_read)
+{
+	struct agate_cursor c = { .nvec = nvec, .vec = vec };
+
+	*bytes_read = 0;
+	if (agate_validate_Type9(vp, ctx, hdr) != 0 || offset < 0 || (uint64_t)offset > hdr->uncompressed_size) {
+		return EINVAL;
+	}
+	agate_put(&c, hdr->attr_bytes + 1 + offset,
+	    (size_t)MIN((uint64_t)size, hdr->uncompressed_size - (uint64_t)offset));
+	*bytes_read = c.total;
+	return 0;
+}
+
+SECURITY_READ_ONLY_EARLY(static decmpfs_registration) AgateType9Reg =
+{
+	.decmpfs_registration = DECMPFS_REGISTRATION_VERSION,
+	.validate          = agate_validate_Type9,
+	.adjust_fetch      = NULL,
+	.fetch             = agate_fetch_Type9,
+	.free_data         = NULL,
+	.get_flags         = NULL
+};
+
+SECURITY_READ_ONLY_EARLY(static decmpfs_registration) AgateType3Reg =
+{
+	.decmpfs_registration = DECMPFS_REGISTRATION_VERSION,
+	.validate          = agate_validate_Type3,
+	.adjust_fetch      = NULL,
+	.fetch             = agate_fetch_Type3,
+	.free_data         = NULL,
+	.get_flags         = NULL
+};
+
+SECURITY_READ_ONLY_EARLY(static decmpfs_registration) AgateType4Reg =
+{
+	.decmpfs_registration = DECMPFS_REGISTRATION_VERSION,
+	.validate          = agate_validate_Type4,
+	.adjust_fetch      = agate_adjust_Type4,
+	.fetch             = agate_fetch_Type4,
+	.free_data         = NULL,
+	.get_flags         = NULL
+};
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 #pragma mark --- decmpfs initialization ---
 
 void
@@ -2360,6 +2713,12 @@ decmpfs_init(void)
 	decmpfs_ctx = vfs_context_create(vfs_context_kernel());
 
 	register_decmpfs_decompressor(CMP_Type1, &Type1Reg);
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	register_decmpfs_decompressor(3, &AgateType3Reg);
+	register_decmpfs_decompressor(4, &AgateType4Reg);
+	register_decmpfs_decompressor(9, &AgateType9Reg);
+	printf("AGATE decmpfs: types 3, 4 (zlib) and 9 (raw) registered\n");
+#endif
 
 	ktriage_register_subsystem_strings(KDBG_TRIAGE_SUBSYS_DECMPFS, &ktriage_decmpfs_subsystem_strings);
 
