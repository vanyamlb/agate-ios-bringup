@@ -260,6 +260,21 @@
 	return ok;
 }
 
+/*
+ * 0557: MT6359P TOPSTATUS (0x2a) for the side and volume-down keys: agate mtk-pmic-keys reads
+ * PWRKEY_DEB bit 1 and HOMEKEY_DEB bit 3 (0 = pressed). Over SWINF_2 like the RTC/VSRAM helpers.
+ */
+bool
+agate_pmic_topstatus(uint16_t *status)
+{
+	if (!pw_acquire()) {
+		return false;
+	}
+	const bool ok = pw_read(0x2a, status) == 0;
+	pw_release();
+	return ok;
+}
