 void
+AppleCLCD::keysFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint16_t st = 0;
+	if (agate_pmic_topstatus(&st)) {
+		const int power = !(st & 0x2), down = !(st & 0x8);
+		if (fb->fKeyLog == 0) {
+			/* first reading: take it as the idle state, send nothing (a wrong polarity cannot hold a key) */
+			fb->fKeyLog = 1;
+			fb->fKeyPower = power;
+			fb->fKeyDown = down;
+			IOLog("AGATE KEYS: first TOPSTATUS %#x (side %d volume-down %d taken as released)\n", st, power, down);
+		} else if (power != fb->fKeyPower || down != fb->fKeyDown) {
+			if (fb->fKeyLog++ < 200) {
+				IOLog("AGATE KEYS: TOPSTATUS %#x side %d volume-down %d\n", st, power, down);
+			}
+			if (power != fb->fKeyPower) {
+				sweet_hid_key(0, power);
+			}
+			if (down != fb->fKeyDown) {
+				sweet_hid_key(2, down);
+			}
+			fb->fKeyPower = power;
+			fb->fKeyDown = down;
+		}
+	}
+	sender->setTimeoutMS(30);
+}
