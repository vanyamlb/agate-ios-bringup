+void
+AppleCLCD::panelWait(void)
+{
+	if (fDsi == NULL) {
+		return;
+	}
+	/* DSI_INTSTA bit 31: busy. Do not write the buffer under a transfer. */
+	for (int i = 0; i < 400 && (fDsi[0x0c / 4] & 0x80000000u); i++) {
+		IODelay(100);
+	}
+}
+
+void
+AppleCLCD::panelKick(void)
+{
+	if (fDsi == NULL || fMutex == NULL) {
+		return;
+	}
+	if (fMbox != NULL) {
+		fMbox[0] = AGATE_MBOX_MAGIC;
+		fMbox[1] = ++fKickSeq;
+	}
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	fMutex[0x20 / 4] = 1;           /* mutex0 EN */
+	fDsi[0] = 0;                    /* DSI_START 0 -> 1 */
+	fDsi[0] = 1;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+}
+
 void
 AppleCLCD::present(const uint8_t *rec)
+{
+	if (fPresentLock == NULL) {
+		presentLocked(rec);
+		return;
+	}
+	IOLockLock(fPresentLock);
+	if (fMbox != NULL) {
+		/* stop the shim kicker before the copy starts */
+		fMbox[0] = AGATE_MBOX_MAGIC;
+		fMbox[1] = ++fKickSeq;
+		__asm__ __volatile__("dsb sy" ::: "memory");
+	}
+	panelWait();
+	presentLocked(rec);
+	panelKick();
+	IOLockUnlock(fPresentLock);
+}
