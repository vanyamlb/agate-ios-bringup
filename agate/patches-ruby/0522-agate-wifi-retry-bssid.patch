+static const struct redwood_sta_bss *
+wf_join_candidate(const struct redwood_sta_join *what, bool any_bssid, const uint8_t *excluded_bssid)
+{
+	const struct redwood_sta_bss *best = NULL;
+	const bool secure = what->security == REDWOOD_STA_WPA2_PSK;
+
+	for (unsigned i = 0; i < wf_heard_count; i++) {
+		const struct redwood_sta_bss *b = &wf_heard[i];
+
+		if (b->ssid_length != what->ssid_length || memcmp(b->ssid, what->ssid, b->ssid_length) != 0 ||
+		    (!any_bssid && memcmp(b->bssid, what->bssid, sizeof(b->bssid)) != 0)) {
+			continue;
+		}
+		if (excluded_bssid != NULL &&
+		    (memcmp(b->bssid, excluded_bssid, sizeof(b->bssid)) == 0 || secure != (wf_element(b, 48) != NULL))) {
+			continue;
+		}
+		if (best == NULL || b->rssi > best->rssi) {
+			best = b;
+		}
+	}
+	return best;
+}
+
+static int
+wf_join(const struct redwood_sta_join *what)
+{
+	const uint8_t zero_bssid[6] = { 0 };
+	const bool any_bssid = memcmp(what->bssid, zero_bssid, sizeof(zero_bssid)) == 0;
+	const struct redwood_sta_bss *candidate = wf_join_candidate(what, any_bssid, NULL);
+	bool auth_unanswered;
+	int error;
+
+	if (candidate == NULL && wf_scan()) {
+		candidate = wf_join_candidate(what, any_bssid, NULL);
+	}
+	if (candidate == NULL) {
+		printf("agate wifi: join: the network asked for is not heard\n");
+		return ENOENT;
+	}
+
+	error = wf_join_bss(what, candidate, &auth_unanswered);
+	if (auth_unanswered && any_bssid) {
+		/* Only retry when there was no authentication response and the caller allowed any BSSID. */
+		candidate = wf_join_candidate(what, true, wf_net.bssid);
+		if (candidate != NULL) {
+			printf("agate wifi: authentication timed out, trying another access point for this network\n");
+			return wf_join_bss(what, candidate, &auth_unanswered);
+		}
+	}
+	return error;
+}
