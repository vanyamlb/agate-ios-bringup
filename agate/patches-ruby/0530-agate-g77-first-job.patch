+/* MT6893 Mali r32p1 TTRX_3485 diagnostic. Use only the stock agate blob,
+ * one isolated GPU address space and the single prevalidated job slot. */
+#define AGATE_GPU_FW_PA            0x41880000UL
+#define AGATE_GPU_FW_SIZE_MAX      0x200000u
+#define AGATE_GPU_WA_GPU_VA        0x100000000ULL
+#define AGATE_GPU_WA_BYTES         384u
+#define AGATE_GPU_WA_OFFSET        8u
+#define AGATE_GPU_WA_BLOB_SIZE     440u
+#define AGATE_GPU_WA_PAGE_SIZE     4096u
+#define AGATE_GPU_WA_PAGE_COUNT    5u
+#define AGATE_GPU_WA_PHYS_MASK     0x000000fffffff000ULL
+
+#define MALI_IRQ_RAW              0x0020
+#define MALI_IRQ_CLEAR            0x0024
+#define MALI_IRQ_MASK             0x0028
+#define MALI_COMMAND              0x0030
+#define MALI_SOFT_RESET           0x01u
+#define MALI_RESET_DONE           (1u << 8)
+#define MALI_SHADER_PRESENT      0x0100
+#define MALI_TILER_PRESENT       0x0110
+#define MALI_L2_PRESENT          0x0120
+#define MALI_SHADER_READY        0x0140
+#define MALI_TILER_READY         0x0150
+#define MALI_L2_READY            0x0160
+#define MALI_SHADER_ON           0x0180
+#define MALI_TILER_ON            0x0190
+#define MALI_L2_ON               0x01a0
+#define MALI_JOB_RAW             0x1000
+#define MALI_JOB_CLEAR           0x1004
+#define MALI_JOB_MASK            0x1008
+#define MALI_JS0_STATUS          0x1824
+#define MALI_JS0_HEAD            0x1840
+#define MALI_JS0_AFFINITY        0x1850
+#define MALI_JS0_CONFIG          0x1858
+#define MALI_JS0_COMMAND         0x1860
+#define MALI_JOB_DONE            1u
+#define MALI_JOB_FAIL            (1u << 16)
+#define MALI_JS_NO_WRITEBACK     (1u << 15)
+#define MALI_MMU_RAW             0x2000
+#define MALI_MMU_CLEAR           0x2004
+#define MALI_MMU_MASK            0x2008
+#define MALI_AS0_TABLE           0x2400
+#define MALI_AS0_MEMATTR         0x2408
+#define MALI_AS0_LOCKADDR        0x2410
+#define MALI_AS0_COMMAND         0x2418
+#define MALI_AS0_FAULT           0x241c
+#define MALI_AS0_FAULT_ADDR      0x2420
+#define MALI_AS0_STATUS          0x2428
+#define MALI_AS0_TRANSCFG        0x2430
+#define MALI_AS_ACTIVE           1u
+#define MALI_AS_UPDATE           1u
+#define MALI_AS_LOCK             2u
+#define MALI_AS_FLUSH_PT         4u
+
+static void
+agate_gpu_write64(vm_offset_t base, uint32_t off, uint64_t value)
+{
+	agate_gpu_write(base, off, (uint32_t)value);
+	agate_gpu_write(base, off + 4, (uint32_t)(value >> 32));
+}
+
+/* Kind 4 is left in the boot image alongside the existing Wi-Fi entries.
+ * Return only the known job data below after validating the full layout. */
+static vm_offset_t
+agate_gpu_wa_payload(void)
+{
+	const vm_offset_t hdr = ml_io_map(AGATE_GPU_FW_PA, 0x1000);
+	if (!hdr || agate_gpu_read(hdr, 0) != 0x57464741u || agate_gpu_read(hdr, 4) != 1) {
+		return 0;
+	}
+	const uint32_t count = agate_gpu_read(hdr, 8);
+	const uint32_t total = agate_gpu_read(hdr, 12);
+	if (count == 0 || count > 16 || total < 16u + 32u * count || total > AGATE_GPU_FW_SIZE_MAX) {
+		return 0;
+	}
+	const vm_offset_t fw = ml_io_map(AGATE_GPU_FW_PA, (total + 0xfffu) & ~0xfffu);
+	if (!fw) {
+		return 0;
+	}
+	vm_offset_t payload = 0;
+	for (unsigned i = 0; i < count; i++) {
+		const unsigned ent = 16u + i * 32u;
+		if (agate_gpu_read(fw, ent) != 4u) {
+			continue;
+		}
+		const uint32_t off = agate_gpu_read(fw, ent + 12);
+		if (payload || (off & 63u) || off < 16u + 32u * count ||
+		    off > total || total - off < AGATE_GPU_WA_BLOB_SIZE ||
+		    agate_gpu_read(fw, ent + 4) != 0 ||
+		    agate_gpu_read(fw, ent + 8) != AGATE_GPU_WA_BLOB_SIZE) {
+			return 0;
+		}
+		const vm_offset_t wa = fw + off;
+		if (agate_gpu_read(wa, 0) != 0x00024157u || agate_gpu_read(wa, 4) != 0x1a0u ||
+		    agate_gpu_read(wa, 0x188) != 0 || agate_gpu_read(wa, 0x18c) != 1u ||
+		    agate_gpu_read(wa, 0x190) != AGATE_GPU_WA_BYTES || agate_gpu_read(wa, 0x194) != 6u ||
+		    agate_gpu_read(wa, 0x198) != AGATE_GPU_WA_OFFSET || agate_gpu_read(wa, 0x19c) != 0 ||
+		    agate_gpu_read(wa, 0x1a0) != 0 || agate_gpu_read(wa, 0x1a4) != 1u ||
+		    agate_gpu_read(wa, 0x1a8) != 0 || agate_gpu_read(wa, 0x1ac) != 0x188u ||
+		    agate_gpu_read(wa, 0x1b0) != 6u || agate_gpu_read(wa, 0x1b4) != 0) {
+			return 0;
+		}
+		payload = wa + AGATE_GPU_WA_OFFSET;
+	}
+	return payload;
+}
+
+static bool
+agate_gpu_wa_tables(vm_offset_t space, vm_offset_t payload, uint64_t *root)
+{
+	uint64_t pa[AGATE_GPU_WA_PAGE_COUNT];
+	for (unsigned n = 0; n < AGATE_GPU_WA_PAGE_COUNT; n++) {
+		const vm_offset_t page = space + n * AGATE_GPU_WA_PAGE_SIZE;
+		const ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)page);
+		pa[n] = ptoa_64(pn) + (page & PAGE_MASK);
+		if (!pn || (pa[n] & ~AGATE_GPU_WA_PHYS_MASK)) {
+			return false;
+		}
+	}
+	for (unsigned n = 0; n < 4; n++) {
+		uint64_t *table = (uint64_t *)(space + n * AGATE_GPU_WA_PAGE_SIZE);
+		/* r32p1: invalid type 2, table/page type 3, AF bit 10.
+		 * Leaf is GPU read-only and non-executable. */
+		for (unsigned j = 0; j < 512; j++) {
+			table[j] = 2ULL;
+		}
+		const unsigned index = (AGATE_GPU_WA_GPU_VA >> (39 - 9 * n)) & 511u;
+		const uint64_t leaf = n == 3 ? (3ULL << 6) | (1ULL << 54) : 0;
+		table[index] = pa[n + 1] | leaf | (1ULL << 10) | 3ULL;
+		table[0] |= 1ULL << 55; /* one valid entry in each table */
+	}
+	uint32_t *job = (uint32_t *)(space + 4u * AGATE_GPU_WA_PAGE_SIZE);
+	for (unsigned i = 0; i < AGATE_GPU_WA_BYTES / 4u; i++) {
+		job[i] = agate_gpu_read(payload, i * 4u);
+	}
+	/* Mali is not CPU-cache coherent. Clean all PTEs and job bytes to PoC. */
+	flush_dcache64((addr64_t)space, AGATE_GPU_WA_PAGE_COUNT * AGATE_GPU_WA_PAGE_SIZE, FALSE);
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	*root = pa[0];
+	return true;
+}
+
+static bool
+agate_gpu_soft_reset(vm_offset_t mali)
+{
+	agate_gpu_write(mali, MALI_IRQ_CLEAR, MALI_RESET_DONE);
+	agate_gpu_write(mali, MALI_COMMAND, MALI_SOFT_RESET);
+	if (!agate_gpu_wait(mali, MALI_IRQ_RAW, MALI_RESET_DONE, MALI_RESET_DONE)) {
+		return false;
+	}
+	agate_gpu_write(mali, MALI_IRQ_CLEAR, MALI_RESET_DONE);
+	return true;
+}
+
+static bool
+agate_gpu_wa_as0(vm_offset_t mali, uint64_t root)
+{
+	if (!agate_gpu_wait(mali, MALI_AS0_STATUS, MALI_AS_ACTIVE, 0)) {
+		return false;
+	}
+	/* AArch64 4 KiB, write-back page walks with read allocation. */
+	agate_gpu_write64(mali, MALI_AS0_TRANSCFG, 6u | (2u << 24) | (1u << 30));
+	agate_gpu_write64(mali, MALI_AS0_TABLE, root);
+	agate_gpu_write64(mali, MALI_AS0_MEMATTR, 0x00004c8d888d8f88ULL);
+	agate_gpu_write(mali, MALI_AS0_COMMAND, MALI_AS_UPDATE);
+	if (!agate_gpu_wait(mali, MALI_AS0_STATUS, MALI_AS_ACTIVE, 0)) {
+		return false;
+	}
+	agate_gpu_write64(mali, MALI_AS0_LOCKADDR, 47u);
+	agate_gpu_write(mali, MALI_AS0_COMMAND, MALI_AS_LOCK);
+	if (!agate_gpu_wait(mali, MALI_AS0_STATUS, MALI_AS_ACTIVE, 0)) {
+		return false;
+	}
+	agate_gpu_write(mali, MALI_AS0_COMMAND, MALI_AS_FLUSH_PT);
+	return agate_gpu_wait(mali, MALI_AS0_STATUS, MALI_AS_ACTIVE, 0);
+}
+
 static void
-agate_gpu_read_id(vm_offset_t mfg, vm_offset_t mali)
+agate_gpu_wa_job(vm_offset_t mali, uint32_t cores)
+{
+	const uint32_t l2 = agate_gpu_read(mali, MALI_L2_PRESENT);
+	const uint32_t tiler = agate_gpu_read(mali, MALI_TILER_PRESENT);
+	if (!l2 || !tiler) {
+		printf("AGATE GPU: WA skipped, no L2 or tiler\n");
+		return;
+	}
+	agate_gpu_write(mali, MALI_L2_ON, l2);
+	if (!agate_gpu_wait(mali, MALI_L2_READY, l2, l2)) {
+		return;
+	}
+	agate_gpu_write(mali, MALI_TILER_ON, tiler);
+	agate_gpu_write(mali, MALI_SHADER_ON, cores);
+	if (!agate_gpu_wait(mali, MALI_TILER_READY, tiler, tiler) ||
+	    !agate_gpu_wait(mali, MALI_SHADER_READY, cores, cores) ||
+	    !agate_gpu_wait(mali, MALI_JS0_COMMAND, 0xffffffffu, 0)) {
+		return;
+	}
+	agate_gpu_write(mali, MALI_JOB_CLEAR, MALI_JOB_DONE | MALI_JOB_FAIL);
+	agate_gpu_write(mali, MALI_MMU_CLEAR, 1u | (1u << 16));
+	agate_gpu_write64(mali, MALI_JS0_HEAD, AGATE_GPU_WA_GPU_VA);
+	agate_gpu_write64(mali, MALI_JS0_AFFINITY, cores);
+	agate_gpu_write(mali, MALI_JS0_CONFIG, MALI_JS_NO_WRITEBACK);
+	agate_gpu_write(mali, MALI_JS0_COMMAND, 1u); /* JS0 START */
+	uint32_t done = 0, fault = 0;
+	for (unsigned tries = 0; tries < 400; tries++) {
+		done = agate_gpu_read(mali, MALI_JOB_RAW) & (MALI_JOB_DONE | MALI_JOB_FAIL);
+		fault = agate_gpu_read(mali, MALI_MMU_RAW);
+		if (done || fault) {
+			break;
+		}
+		delay(50);
+	}
+	if (done == MALI_JOB_DONE && !fault) {
+		printf("AGATE GPU: WA hardware job completed on JS0\n");
+	} else {
+		printf("AGATE GPU: WA job failed or timed out, JS raw %#x status %#x MMU %#x AS0 fault %#x at %#x:%#x\n",
+		    done, agate_gpu_read(mali, MALI_JS0_STATUS), fault, agate_gpu_read(mali, MALI_AS0_FAULT),
+		    agate_gpu_read(mali, MALI_AS0_FAULT_ADDR + 4), agate_gpu_read(mali, MALI_AS0_FAULT_ADDR));
+	}
+}
+
+/* Return false if we could not stop the GPU after making its DMA mapping
+ * visible. Leave its pages wired and avoid further power changes then. */
+static bool
+agate_gpu_wa(vm_offset_t mali)
+{
+	const uint32_t cores = agate_gpu_read(mali, MALI_SHADER_PRESENT);
+	const vm_offset_t payload = agate_gpu_wa_payload();
+	if (!payload || cores != 0x660067u || agate_gpu_read(mali, MALI_SHADER_PRESENT + 4) ||
+	    agate_gpu_read(mali, 0x0014) != 0x2830u || !(agate_gpu_read(mali, 0x0018) & 1u) ||
+	    !(agate_gpu_read(mali, 0x001c) & 1u)) {
+		printf("AGATE GPU: WA skipped, firmware or hardware capability check failed\n");
+		return true;
+	}
+	const vm_size_t size = round_page(AGATE_GPU_WA_PAGE_COUNT * AGATE_GPU_WA_PAGE_SIZE);
+	vm_offset_t space = 0;
+	if (kmem_alloc(kernel_map, &space, size, KMA_DATA | KMA_ZERO,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("AGATE GPU: WA scratch allocation failed\n");
+		return true;
+	}
+	uint64_t root;
+	if (!agate_gpu_wa_tables(space, payload, &root) || !agate_gpu_soft_reset(mali)) {
+		printf("AGATE GPU: WA table preparation or initial reset failed\n");
+		kmem_free(kernel_map, space, size);
+		return true;
+	}
+	agate_gpu_write(mali, MALI_IRQ_MASK, 0);
+	agate_gpu_write(mali, MALI_JOB_MASK, 0);
+	agate_gpu_write(mali, MALI_MMU_MASK, 0);
+	if (agate_gpu_wa_as0(mali, root)) {
+		printf("AGATE GPU: WA AS0 configured, starting the vendor job\n");
+		agate_gpu_wa_job(mali, cores);
+	}
+	if (!agate_gpu_soft_reset(mali)) {
+		printf("AGATE GPU: WA cleanup reset failed; scratch pages remain wired until reboot\n");
+		return false;
+	}
+	kmem_free(kernel_map, space, size);
+	return true;
+}
