+/* Queue one Ethernet frame (ue0 and AgateECMEthernet). 0 = queued. */
+int
+agate_ecm_queue_frame(const uint8_t *data, uint32_t len)
+{
+	uint8_t pad = 0;
+
+	if (!ecm.on || len < ETHER_HDR_LEN || len > ECM_FRAME_MAX) {
+		ecm.tx_drops++;
+		return -1;
+	}
+	uint32_t wire = len + (((len % ECM_MPS) == 0) ? 1u : 0u);   /* short packet end */
+	lck_spin_lock(ecm.lock);
+	if ((ecm.txq_head - ecm.txq_tail) + wire + 2 > ECM_TXQ_BYTES) {
+		lck_spin_unlock(ecm.lock);
+		ecm.tx_drops++;
+		return -1;
+	}
+	uint8_t h[2] = { (uint8_t)wire, (uint8_t)(wire >> 8) };
+	ecm_txq_put(h, 2);
+	ecm_txq_put(data, len);
+	if (wire != len) {
+		ecm_txq_put(&pad, 1);
+	}
+	lck_spin_unlock(ecm.lock);
+	ecm.tx_frames++;
+	ruby_usb_rx_kick();             /* IRQ mode: wake the QMU workloop */
+	return 0;
+}
