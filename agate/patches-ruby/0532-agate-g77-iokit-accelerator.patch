+/* ---- accelerator ---- */
+
+OSDefineMetaClassAndStructors(VivaGPUAccelerator, IOAcceleratorES);
+
+IOWorkLoop *
+VivaGPUAccelerator::getWorkLoop(void) const
+{
+	return fWorkLoop;
+}
+
+bool
+VivaGPUAccelerator::start(IOService *provider)
+{
+	int mode = 0;
+	if (!PE_parse_boot_argn("agategpu", &mode, sizeof(mode)) || (mode != 5 && mode != 6)) {
+		return false;
+	}
+	fMode = mode;
+	fCacheMode = 1;
+	PE_parse_boot_argn("vivagpucache", &fCacheMode, sizeof(fCacheMode));
+	int flag = 1;
+	PE_parse_boot_argn("vivagpulazy", &flag, sizeof(flag));
+	fLazy = flag != 0 && fCacheMode != 0;
+	flag = 1;
+	PE_parse_boot_argn("vivagpuwc", &flag, sizeof(flag));
+	fWC = flag != 0 && fCacheMode != 0;
+	flag = 0;
+	PE_parse_boot_argn("vivagpuflushid", &flag, sizeof(flag));
+	fFlushReduce = flag != 0;
+	flag = 0;
+	PE_parse_boot_argn("vivagpufastkick", &flag, sizeof(flag));
+	fFastKick = flag != 0;
+	int64_t mib = GPU_MEMORY_LIMIT >> 20;
+	PE_parse_boot_argn("vivagpumemtotal", &mib, sizeof(mib));
+	fMemLimit = mib > 0 && mib <= (GPU_MEMORY_LIMIT >> 20) ? mib << 20 : GPU_MEMORY_LIMIT;
+	mib = GPU_PROCESS_LIMIT >> 20;
+	PE_parse_boot_argn("vivagpumem", &mib, sizeof(mib));
+	fProcLimit = mib > 0 && mib <= (GPU_PROCESS_LIMIT >> 20) ? mib << 20 : GPU_PROCESS_LIMIT;
+	fProbeMode = 1;
+	PE_parse_boot_argn("vivagpuprobe", &fProbeMode, sizeof(fProbeMode));
+	fProbeLock = IOLockAlloc();
+	fFastLock = IOSimpleLockAlloc();
+	fCallLock = IOSimpleLockAlloc();
+	fWorkLoop = IOWorkLoop::workLoop();
+	if (fWorkLoop == NULL || fProbeLock == NULL || fFastLock == NULL || fCallLock == NULL ||
+	    !IOAcceleratorES::start(provider)) {
+		return false;
+	}
+	fMap = provider->mapDeviceMemoryWithIndex(0);
+	if (fMap == NULL || fMap->getLength() < 0x4000) {
+		IOLog("AGATE GPU: missing Mali register range\n");
+		return false;
+	}
+	fMali = (vm_offset_t)fMap->getVirtualAddress();
+	fGate = IOCommandGate::commandGate(this);
+	fTimer = IOTimerEventSource::timerEventSource(this, &VivaGPUAccelerator::jobTimer);
+	fStartTimer = IOTimerEventSource::timerEventSource(this, &VivaGPUAccelerator::startTimer);
+	IOInterruptEventSource::Action actions[3] = {
+		&VivaGPUAccelerator::gpuInterrupt, &VivaGPUAccelerator::mmuInterrupt, &VivaGPUAccelerator::jobInterrupt,
+	};
+	if (fGate == NULL || fTimer == NULL || fStartTimer == NULL || fWorkLoop->addEventSource(fGate) != kIOReturnSuccess ||
+	    fWorkLoop->addEventSource(fTimer) != kIOReturnSuccess || fWorkLoop->addEventSource(fStartTimer) != kIOReturnSuccess) {
+		return false;
+	}
+	for (int i = 0; i < 3; i++) {
+		/* the job interrupt has a filter: K0e fast kick and the interrupt timestamps */
+		if (i == 2) {
+			fIrq[i] = IOFilterInterruptEventSource::filterInterruptEventSource(this, actions[i],
+			    &VivaGPUAccelerator::jobFilter, provider, i);
+		} else {
+			fIrq[i] = IOInterruptEventSource::interruptEventSource(this, actions[i], provider, i);
+		}
+		if (fIrq[i] == NULL || fWorkLoop->addEventSource(fIrq[i]) != kIOReturnSuccess) {
+			IOLog("VIVA GPU: no interrupt %d\n", i);
+			return false;
+		}
+	}
+	fStartDeadline = nowMs() + 180000;
+	IOLog("AGATE GPU: IOKit waiting for board initialization (agategpu=%d)\n", fMode);
+	fStartTimer->setTimeoutMS(250);
+	return true;
+}
+
+void
+VivaGPUAccelerator::free(void)
+{
+	for (int i = 0; i < 3; i++) {
+		if (fIrq[i] != NULL) {
+			fIrq[i]->disable();
+			fWorkLoop->removeEventSource(fIrq[i]);
+			fIrq[i]->release();
+		}
+	}
+	if (fTimer != NULL) {
+		fTimer->cancelTimeout();
+		fWorkLoop->removeEventSource(fTimer);
+		fTimer->release();
+	}
+	if (fStartTimer != NULL) {
+		fStartTimer->cancelTimeout();
+		fWorkLoop->removeEventSource(fStartTimer);
+		fStartTimer->release();
+	}
+	if (fGate != NULL) {
+		fWorkLoop->removeEventSource(fGate);
+		fGate->release();
+	}
+	OSSafeReleaseNULL(fMap);
+	if (fHeapList != NULL) {
+		IODelete(fHeapList, VivaGPUBO *, fHeapCap);
+	}
+	if (fFastLock != NULL) {
+		IOSimpleLockFree(fFastLock);
+		fFastLock = NULL;
+	}
+	if (fCallLock != NULL) {
+		IOSimpleLockFree(fCallLock);
+		fCallLock = NULL;
+	}
+	OSSafeReleaseNULL(fPromises);
+	if (fK0jStack != NULL) {
+		IODelete(fK0jStack, K0jFrame, kVivaK0jDepth);
+	}
+	if (fProbeLock != NULL) {
+		IOLockFree(fProbeLock);
+	}
+	OSSafeReleaseNULL(fWorkLoop);
+	IOAcceleratorES::free();
+}
+
+IOReturn
+VivaGPUAccelerator::newUserClient(task_t owningTask, void *securityID, UInt32 type, IOUserClient **handler)
+{
+	if (!fPublished || !fPowered) {
+		return kIOReturnNotReady;
+	}
+	if (type != VGPU_CLIENT_TYPE) {
+		char proc[20];
+		proc_selfname(proc, sizeof(proc));
+		probeNote(proc, type, ~0u, 0, 0);
+		IOLog("VIVA GPU: %s[%d] opens user client type 0x%x (not vgpu): %s\n", proc, proc_selfpid(), type,
+		    fProbeMode ? "probe client" : "refused");
+		if (!fProbeMode) {
+			return kIOReturnUnsupported;
+		}
+		VivaGPUProbeClient *probe = new VivaGPUProbeClient;
+		if (probe == NULL) {
+			return kIOReturnNoMemory;
+		}
+		if (!probe->initWithTask(owningTask, securityID, type) || !probe->attach(this)) {
+			probe->release();
+			return kIOReturnError;
+		}
+		if (!probe->start(this)) {
+			probe->detach(this);
+			probe->release();
+			return kIOReturnError;
+		}
+		*handler = probe;
+		return kIOReturnSuccess;
+	}
+	VivaGPUUserClient *client = new VivaGPUUserClient;
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type) || !client->attach(this)) {
+		client->release();
+		return kIOReturnError;
+	}
+	if (!client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnError;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+/* Gated. */
+void
+VivaGPUAccelerator::vmLink(VivaGPUVM *vm)
+{
+	vm->nextVM = fVMs;
+	fVMs = vm;
+}
+
+/*
+ * Gated. Limits: all GPU memory (vivagpumemtotal, MiB, default 2048) and per process, summed over its connections
+ * (vivagpumem, MiB, default 1024). Refusals end as kIOReturnNoMemory for CREATE_BO, a failed map, or a heap that
+ * cannot grow (the chain fails), never a panic.
+ */
+bool
+VivaGPUAccelerator::chargeMemory(VivaGPUVM *vm, int64_t bytes)
+{
+	if (bytes > 0) {
+		int64_t proc = 0;
+		for (VivaGPUVM *v = fVMs; v != NULL; v = v->nextVM) {
+			if (v->pid == vm->pid) {
+				proc += v->bytes;
+			}
+		}
+		if (fMemory + bytes > fMemLimit || proc + bytes > fProcLimit) {
+			if (fMemRefused++ < 16) {
+				IOLog("VIVA GPU: %s[%d] out of GPU memory: +%lld KiB refused (process %lld/%lld MiB, all %lld/%lld "
+				    "MiB)\n", vm->proc, vm->pid, bytes >> 10, proc >> 20, fProcLimit >> 20, fMemory >> 20,
+				    fMemLimit >> 20);
+			}
+			return false;
+		}
+	}
+	fMemory += bytes;
+	vm->bytes += bytes;
+	if (fMemory > fMemPeak) {
+		fMemPeak = fMemory;
+	}
+	return true;
+}
+
+/* GPU memory per process (connections of one pid summed). */
+void
+VivaGPUAccelerator::memoryDump(char **out, char *end)
+{
+	say(out, end, "memory: %lld KiB (peak %lld KiB, limit %lld MiB, %lld MiB per process), %llu refusals\n",
+	    fMemory >> 10, fMemPeak >> 10, fMemLimit >> 20, fProcLimit >> 20, fMemRefused);
+	for (VivaGPUVM *v = fVMs; v != NULL; v = v->nextVM) {
+		bool seen = false;
+		for (VivaGPUVM *w = fVMs; w != v; w = w->nextVM) {
+			seen = seen || w->pid == v->pid;
+		}
+		if (seen) {
+			continue;
+		}
+		int64_t bytes = 0, imported = 0;
+		uint32_t conns = 0, bos = 0, faults = 0;
+		for (VivaGPUVM *w = v; w != NULL; w = w->nextVM) {
+			if (w->pid == v->pid) {
+				bytes += w->bytes;
+				imported += w->imported;
+				bos += w->bos;
+				faults += w->faults;
+				conns++;
+			}
+		}
+		say(out, end, "  %s[%d]: %lld KiB in %u BOs, %lld KiB imported, %u connection%s, %u MMU faults\n", v->proc,
+		    v->pid, bytes >> 10, bos, imported >> 10, conns, conns == 1 ? "" : "s", faults);
+	}
+}
+
+/* ---- unknown user clients and property reads (K1: what IOGPU/QuartzCore/Metal ask for) ---- */
+
+#define PROBE_LOG_MAX   48      /* log lines per client; "gpu probe" keeps counting */
+/* selector tags in the probe table (high 16 bits) for calls that are not external methods */
+#define PROBE_TRAP      0x74720000u
+#define PROBE_MEMORY    0x6d650000u
+#define PROBE_NOTIFY    0x6e6f0000u
+
+/* One table line per (process, type, selector); selector ~0 = the open itself. */
+void
+VivaGPUAccelerator::probeNote(const char *proc, uint32_t type, uint32_t selector, uint32_t inSize, uint32_t outSize)
+{
+	IOLockLock(fProbeLock);
+	uint32_t i;
+	for (i = 0; i < fProbeCount; i++) {
+		ProbeEntry *e = &fProbe[i];
+		if (e->type == type && e->selector == selector && strncmp(e->proc, proc, sizeof(e->proc)) == 0) {
+			break;
+		}
+	}
+	if (i == fProbeCount) {
+		if (fProbeCount == kProbeMax) {
+			fProbeDropped++;
+			IOLockUnlock(fProbeLock);
+			return;
+		}
+		ProbeEntry *e = &fProbe[fProbeCount++];
+		bzero(e, sizeof(*e));
+		strlcpy(e->proc, proc, sizeof(e->proc));
+		e->type = type;
+		e->selector = selector;
+	}
+	fProbe[i].count++;
+	fProbe[i].inSize = inSize;
+	fProbe[i].outSize = outSize;
+	IOLockUnlock(fProbeLock);
+}
+
+void
+VivaGPUAccelerator::propertyRead(const char *key, bool found)
+{
+	char proc[20];
+	proc_selfname(proc, sizeof(proc));
+	IOLockLock(fProbeLock);
+	uint32_t i;
+	for (i = 0; i < fPropCount; i++) {
+		if (strncmp(fProps[i].key, key, sizeof(fProps[i].key) - 1) == 0 &&
+		    strncmp(fProps[i].proc, proc, sizeof(fProps[i].proc)) == 0) {
+			break;
+		}
+	}
+	bool first = i == fPropCount;
+	if (first) {
+		if (fPropCount == kPropMax) {
+			fPropDropped++;
+			IOLockUnlock(fProbeLock);
+			return;
+		}
+		bzero(&fProps[i], sizeof(fProps[i]));
+		strlcpy(fProps[i].proc, proc, sizeof(fProps[i].proc));
+		strlcpy(fProps[i].key, key, sizeof(fProps[i].key));
+		fPropCount++;
+	}
+	fProps[i].count++;
+	fProps[i].found = found;
+	IOLockUnlock(fProbeLock);
+	if (first) {
+		IOLog("VIVA GPU: %s[%d] reads property \"%s\": %s\n", proc, proc_selfpid(), key, found ? "found" : "MISSING");
+	}
+}
+
+void
+VivaGPUAccelerator::probeDump(char **out, char *end)
+{
+	IOLockLock(fProbeLock);
+	say(out, end, "unknown user clients (%u calls dropped, vivagpuprobe=%d):\n", fProbeDropped, fProbeMode);
+	for (uint32_t i = 0; i < fProbeCount; i++) {
+		ProbeEntry *e = &fProbe[i];
+		uint32_t tag = e->selector >> 16, n = e->selector & 0xffff;
+		if (e->selector == ~0u) {
+			say(out, end, "  %s type 0x%x: opened %u times\n", e->proc, e->type, e->count);
+		} else if (tag == (PROBE_NOTIFY >> 16) && n >= 0xfffe) {
+			say(out, end, "  %s type 0x%x %s: %u calls\n", e->proc, e->type, n == 0xffff ? "setProperties" :
+			    "connectClient", e->count);
+		} else {
+			say(out, end, "  %s type 0x%x %s %u: %u calls, last in %u out %u bytes\n", e->proc, e->type,
+			    tag == (PROBE_TRAP >> 16) ? "trap" : tag == (PROBE_MEMORY >> 16) ? "memory type" :
+			    tag == (PROBE_NOTIFY >> 16) ? "notification port type" : "sel", n, e->count, e->inSize,
+			    e->outSize);
+		}
+	}
+	say(out, end, "property reads (%u dropped):\n", fPropDropped);
+	for (uint32_t i = 0; i < fPropCount; i++) {
+		say(out, end, "  %s \"%s\" %s x%u\n", fProps[i].proc, fProps[i].key, fProps[i].found ? "found" : "MISSING",
+		    fProps[i].count);
+	}
+	IOLockUnlock(fProbeLock);
+}
+
+/* IOUserClient.cpp: registry property reads by userspace (key "*" = all properties). */
+extern "C" void
+viva_gpu_property_read(IORegistryEntry *entry, const char *key, bool found)
+{
+	VivaGPUAccelerator *gpu = gVivaGPU;
+	if (gpu != NULL && entry == gpu) {
+		gpu->propertyRead(key, found);
+	}
+}
