+struct agate_gpu_runtime {
+	vm_offset_t spm, infra, mfg;
+	struct agate_gpu_power_state power;
+	uint32_t spm_config;
+	bool restore_gate;
+};
+
+static struct agate_gpu_runtime agate_gpu_runtime;
+static unsigned agate_gpu_runtime_available;
+
+bool
+agate_gpu_runtime_ready(void)
+{
+	return __atomic_load_n(&agate_gpu_runtime_available, __ATOMIC_ACQUIRE) != 0;
+}
+
+/* The IOKit command gate serializes all runtime calls. The caller has
+ * already confirmed a reset, so GPU DMA can no longer be active. */
+void
+agate_gpu_runtime_off(void)
+{
+	if (!__atomic_exchange_n(&agate_gpu_runtime_available, 0u, __ATOMIC_ACQ_REL)) {
+		return;
+	}
+	struct agate_gpu_runtime *rt = &agate_gpu_runtime;
+	if (rt->restore_gate) {
+		agate_gpu_write(rt->mfg, AGATE_GPU_BG3D_SET, AGATE_GPU_BG3D_GATE);
+	}
+	if (!agate_gpu_power_down(rt->spm, rt->infra, &rt->power)) {
+		printf("AGATE GPU: runtime shutdown timeout; reboot before retrying\n");
+		return;
+	}
+	if (!(rt->spm_config & 1u)) {
+		agate_gpu_write(rt->spm, AGATE_GPU_PWR_ACCESS, AGATE_GPU_SPM_KEY | rt->spm_config);
+	}
+}
