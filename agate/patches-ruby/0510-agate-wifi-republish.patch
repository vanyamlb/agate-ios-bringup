diff --git a/iokit/Kernel/arm/AgateWLAN.cpp b/iokit/Kernel/arm/AgateWLAN.cpp
index 56fdd59..4746cba 100644
--- a/iokit/Kernel/arm/AgateWLAN.cpp
+++ b/iokit/Kernel/arm/AgateWLAN.cpp
@@ -119,6 +119,34 @@ OSDefineMetaClassAndStructors(AgateWLAN, IO80211Controller);
 
 static AgateWLAN *gAgateWLAN;
 
+/* what wifid asks IOKit for (IOServiceMatched, IOPropertyMatch {IO80211InterfaceRole: Infrastructure}):
+ * does it find our interface? */
+static void
+agate_wlan_selftest(AgateWLAN *self, const char *when)
+{
+	OSDictionary *pm = OSDictionary::withCapacity(1);
+	OSDictionary *m = OSDictionary::withCapacity(1);
+	OSString *v = OSString::withCString("Infrastructure");
+	IOService *found = NULL;
+	OSObject *role = self->fNetif ? self->fNetif->copyProperty("IO80211InterfaceRole") : NULL;
+	OSObject *ifname = self->fNetif ? self->fNetif->copyProperty("IOInterfaceName") : NULL;
+
+	if (pm && m && v) {
+		pm->setObject("IO80211InterfaceRole", v);
+		m->setObject(gIOPropertyMatchKey, pm);
+		found = IOService::copyMatchingService(m);
+	}
+	IOLog("AGATE WLAN: selftest (%s): interface role %s, IOInterfaceName %s, state 0x%x; property match finds %s\n",
+	    when, role ? role->getMetaClass()->getClassName() : "NONE", ifname ? ifname->getMetaClass()->getClassName() : "NONE",
+	    self->fNetif ? (unsigned)self->fNetif->getState() : 0, found ? found->getMetaClass()->getClassName() : "NOTHING");
+	OSSafeReleaseNULL(found);
+	OSSafeReleaseNULL(role);
+	OSSafeReleaseNULL(ifname);
+	OSSafeReleaseNULL(pm);
+	OSSafeReleaseNULL(m);
+	OSSafeReleaseNULL(v);
+}
