+/* the station is up (agate_mtkwifi_attach, ~45 s in): register the interface again, so the
+ * IOServiceMatched notification of wifid's (started earlier) is sent for it now */
+extern "C" void
+agate_wlan_republish(void)
+{
+	if (gAgateWLAN != NULL && gAgateWLAN->fNetif != NULL) {
+		agate_wlan_selftest(gAgateWLAN, "station up");
+		gAgateWLAN->fNetif->registerService();
+		IOLog("AGATE WLAN: interface registered again for wifid\n");
+	}
+}
