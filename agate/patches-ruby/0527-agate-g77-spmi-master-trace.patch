+static void
+agate_pmif_trace(vm_offset_t pmif, vm_offset_t master, const char *phase)
+{
+	printf("AGATE GPU: PMIF %s STA %#x irq %#x/%#x/%#x/%#x/%#x; SPMI op %#x dbg %#x rec %#x/%#x\n",
+	    phase, agate_gpu_read(pmif, AGATE_PMIF_STA),
+	    agate_gpu_read(pmif, AGATE_PMIF_IRQ_FLAG0), agate_gpu_read(pmif, AGATE_PMIF_IRQ_FLAG1),
+	    agate_gpu_read(pmif, AGATE_PMIF_IRQ_FLAG2), agate_gpu_read(pmif, AGATE_PMIF_IRQ_FLAG3),
+	    agate_gpu_read(pmif, AGATE_PMIF_IRQ_FLAG4), agate_gpu_read(master, AGATE_SPMI_OP_STATUS),
+	    agate_gpu_read(master, AGATE_SPMI_DEBUG), agate_gpu_read(master, AGATE_SPMI_RECORD0),
+	    agate_gpu_read(master, AGATE_SPMI_RECORD1));
+}
