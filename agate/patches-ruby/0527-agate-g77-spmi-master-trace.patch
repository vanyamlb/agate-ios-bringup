+static vm_offset_t
+agate_spmi_master_probe(vm_offset_t clocks)
+{
+	const uint32_t mux = agate_gpu_read(clocks, AGATE_SPMI_CLK_SEL);
+	printf("AGATE GPU: SPMI clock CLK_CFG_16 %#x (parent %u gate %u)\n",
+	    mux, mux & 7u, (unsigned)((mux & AGATE_SPMI_CLK_GATE) != 0));
+	if (mux & AGATE_SPMI_CLK_GATE) {
+		return 0;
+	}
+	vm_offset_t master = ml_io_map(AGATE_SPMI_MASTER_PA, 0x1000);
+	if (master == 0) {
+		printf("AGATE GPU: SPMI master map failed\n");
+		return 0;
+	}
+
+	const uint32_t request = agate_gpu_read(master, AGATE_SPMI_REQUEST);
+	const uint32_t group = agate_gpu_read(master, AGATE_SPMI_GROUP);
+	printf("AGATE GPU: SPMI master request %#x group %#x (FDT group 11 enabled %u) sample %#x op %#x\n",
+	    request, group, (unsigned)((group & AGATE_SPMI_VGPU_GROUP) != 0),
+	    agate_gpu_read(master, AGATE_SPMI_SAMPLING), agate_gpu_read(master, AGATE_SPMI_OP_STATUS));
+	if (!(request & 1u)) {
+		printf("AGATE GPU: SPMI master has no request enable\n");
+		return 0;
+	}
+	return master;
+}
