@@ -98,6 +98,8 @@ extern int sweet_goodix_cmd(char *cmd);
 #define PR_WDT_MODE_AUTO  (1u << 4)
 #define PR_WDT_SWRST_KEY 0x1209u
 #define PR_BOOT_BOOTLOADER 3u
+#define PR_AGATE_WDT_BYPASS_PWRKEY (1u << 13)
+#define PR_AGATE_WDT_MODE_CLEAR ((1u << 3) | (1u << 4) | (1u << 6) | (1u << 7))
 
 /*
  * R0 read-only map.  These offsets are taken from the vendor drivers:
@@ -772,6 +774,23 @@ pr_reboot_bootloader(void)
 		printf("RUBY WDT: not mapped\n");
 		return 1;
 	}
+	if (PE_parse_boot_argn("agategpu", &agate_gpu_mode, sizeof(agate_gpu_mode)) && agate_gpu_mode == 7) {
+		extern bool agate_rtc_mark_fastboot(void);
+		if (!agate_rtc_mark_fastboot()) {
+			printf("RUBY WDT: Agate RTC Fastboot marker could not be verified\n");
+			return 1;
+		}
+		/* Match agate Android 4.14's wd_api.c and wdt_v2: RTC selects
+		 * Fastboot. NONRST2 bit 13 is clear for a bootloader reset. */
+		pr_wr32(pr.wdt, PR_WDT_RST, PR_WDT_RST_ALT);
+		old = pr_rd32(pr.wdt, PR_WDT_NONRST2);
+		pr_wr32(pr.wdt, PR_WDT_NONRST2, old & ~PR_AGATE_WDT_BYPASS_PWRKEY);
+		mode = pr_rd32(pr.wdt, PR_WDT_MODE) & (0x00ffffffu & ~PR_AGATE_WDT_MODE_CLEAR);
+		pr_wr32(pr.wdt, PR_WDT_MODE, mode | PR_WDT_MODE_KEY | PR_WDT_MODE_EXTEN);
+		printf("RUBY WDT: Agate RTC Fastboot marker verified; TOPRGU reset\n");
+		pr_wr32(pr.wdt, PR_WDT_SWRST, PR_WDT_SWRST_KEY);
+		return 1;
+	}
 	old = pr_rd32(pr.wdt, PR_WDT_NONRST2);
 	new = (old & ~0xfu) | PR_BOOT_BOOTLOADER;
 	pr_wr32(pr.wdt, PR_WDT_NONRST2, new);
@@ -782,14 +801,9 @@ pr_reboot_bootloader(void)
 		printf("RUBY WDT: bootloader mode readback failed\n");
