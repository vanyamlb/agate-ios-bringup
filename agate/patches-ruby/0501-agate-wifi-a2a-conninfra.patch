diff --git a/bsd/dev/agate_conninfra/compat/consys_reg_util.h b/bsd/dev/agate_conninfra/compat/consys_reg_util.h
new file mode 100644
index 0000000..3b6aebe
--- /dev/null
+++ b/bsd/dev/agate_conninfra/compat/consys_reg_util.h
@@ -0,0 +1,43 @@
+/* agate: register helpers with the semantics of MediaTek's consys_reg_util.h. */
+#ifndef _PLATFORM_CONSYS_REG_UTIL_H_
+#define _PLATFORM_CONSYS_REG_UTIL_H_
+#include "plat_def.h"
+#define KBYTE (1024*sizeof(char))
+#ifndef GENMASK
+#define GENMASK(h, l) (((~0UL) - (1UL << (l)) + 1) & (~0UL >> (BITS_PER_LONG - 1 - (h))))
+#endif
+#define GET_BIT_MASK(value, mask) ((value) & (mask))
+#define SET_BIT_MASK(pdest, value, mask) (*(pdest) = (GET_BIT_MASK(*(pdest), ~(mask)) | GET_BIT_MASK(value, mask)))
+#define GET_BIT_RANGE(data, end, begin) ((data) & GENMASK(end, begin))
+#define SET_BIT_RANGE(pdest, data, end, begin) (SET_BIT_MASK(pdest, data, GENMASK(end, begin)))
+#define CONSYS_SET_BIT(REG, BITVAL) do { writel(readl(REG) | (unsigned int)(BITVAL), REG); mb(); } while (0)
+#define CONSYS_CLR_BIT(REG, BITVAL) do { writel(readl(REG) & ~(unsigned int)(BITVAL), REG); mb(); } while (0)
+#define CONSYS_CLR_BIT_WITH_KEY(REG, BITVAL, KEY) do { \
+	unsigned int _v = readl(REG); _v &= ~((unsigned int)(BITVAL)); _v |= (unsigned int)(KEY); \
+	writel(_v, REG); mb(); } while (0)
+#define CONSYS_REG_READ(addr) readl(addr)
+#define CONSYS_REG_READ_BIT(addr, BITVAL) (readl(addr) & ((unsigned int)(BITVAL)))
+#define CONSYS_REG_WRITE(addr, data) do { writel(data, addr); mb(); } while (0)
+#define CONSYS_REG_WRITE_RANGE(reg, data, end, begin) do { \
+	unsigned int _v = CONSYS_REG_READ(reg); SET_BIT_RANGE(&_v, data, end, begin); \
+	CONSYS_REG_WRITE(reg, _v); } while (0)
+#define CONSYS_REG_WRITE_MASK(reg, data, mask) do { \
+	unsigned int _v = CONSYS_REG_READ(reg); SET_BIT_MASK(&_v, data, mask); \
+	CONSYS_REG_WRITE(reg, _v); } while (0)
+#define CONSYS_REG_WRITE_OFFSET_RANGE(reg, value, reg_offset, value_offset, size) ({ \
+	unsigned int _d = (unsigned int)((value) >> (value_offset)); \
+	_d = GET_BIT_RANGE(_d, size, 0); _d = _d << (reg_offset); \
+	CONSYS_REG_WRITE_RANGE(reg, _d, ((reg_offset) + ((size) - 1)), reg_offset); })
+#define CONSYS_REG_WRITE_BIT(reg, offset, val) CONSYS_REG_WRITE_OFFSET_RANGE(reg, ((val) & 1), offset, 0, 1)
+#define CONSYS_REG_BIT_POLLING(addr, bit_index, exp_val, loop, delay_us, success) do { \
+	unsigned int _pc = 0; unsigned int _rv; success = 0; \
+	_rv = (CONSYS_REG_READ_BIT(addr, (0x1 << bit_index)) >> bit_index); \
+	while (_rv != (exp_val)) { \
+		if (_pc > (loop)) { success = -1; break; } \
+		_rv = (CONSYS_REG_READ_BIT(addr, (0x1 << bit_index)) >> bit_index); \
+		udelay(delay_us); _pc++; } } while (0)
+#define ADDR(Field) (Field##_ADDR)
+#define MASK(Field) (Field##_MASK)
+#define SHFT(Field) (Field##_SHFT)
+#define CONSYS_REG_WRITE_HW_ENTRY(Field, Value) CONSYS_REG_WRITE_MASK(ADDR(Field), (Value << SHFT(Field)), MASK(Field))
+#endif
