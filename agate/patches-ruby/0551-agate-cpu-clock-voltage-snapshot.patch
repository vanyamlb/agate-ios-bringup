+/* 0551: read-only CPU clock/voltage snapshot (agate 4.14 mtk_cpufreq_platform.c, mt6315 regulator). */
+static uint32_t
+agateCpuKhz(uint32_t con1, uint32_t ckdiv)
+{
+	const uint32_t posdiv = (con1 >> 24) & 7u;
+	uint32_t khz = (((con1 & 0x3fffffu) * 26u) >> 14) * 1000u;
+	khz = posdiv == 0 ? khz : posdiv == 1 ? khz / 2 : posdiv == 2 ? khz / 4 : posdiv == 3 ? khz / 8 : khz / 16;
+	const uint32_t sel = (ckdiv >> 17) & 0x1fu;
+	switch (sel) {
+	case 9: return khz * 3 / 4;
+	case 10: return khz / 2;
+	case 11: return khz / 4;
+	case 17: return khz * 4 / 5;
+	case 18: return khz * 3 / 5;
+	case 19: return khz * 2 / 5;
+	case 20: return khz / 5;
+	case 25: return khz * 5 / 6;
+	case 26: return khz * 4 / 6;
+	case 27: return khz / 2;
+	case 28: return khz / 3;
+	case 29: return khz / 6;
+	default: return khz;
+	}
+}
+
+/* One MT6315 byte read over PMIF AP SWINF_2 (as agate_gpu.c's agate_mt6315_read, any SID). */
+static bool
+agateMt6315Read(volatile uint32_t *pmif, uint32_t sid, uint16_t address, uint8_t *value)
+{
+	for (int i = 0; i < 200 && ((pmif[0x0ca8 / 4] >> 1) & 7u) != 0; i++) {
+		IODelay(50);
+	}
+	if (((pmif[0x0ca8 / 4] >> 1) & 7u) != 0) {
+		return false;
+	}
+	pmif[0x0c80 / 4] = (3u << 30) | (sid << 24) | address;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	for (int i = 0; i < 200 && ((pmif[0x0ca8 / 4] >> 1) & 7u) != 6; i++) {
+		IODelay(50);
+	}
+	if (((pmif[0x0ca8 / 4] >> 1) & 7u) != 6) {
+		return false;
+	}
+	*value = (uint8_t)pmif[0x0c94 / 4];
+	pmif[0x0ca4 / 4] = 1;
+	__asm__ __volatile__("dsb sy" ::: "memory");
+	return true;
+}
